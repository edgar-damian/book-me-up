# Template for server/.env. Values come from the Supabase dashboard; without
# them, only the home page works.

# Project Settings -> Data API -> Project URL (https://<project-ref>.supabase.co)
SUPABASE_URL=
# The Project URL followed by /auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=

# Project Settings -> API Keys
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Connect -> connection string, and the password set when the project was
# created. Required by config.py but not used yet.
SUPABASE_DB_URL=
SB_DB_PASSWORD_ON_SETUP=

# Optional. The defaults suit local development.
# APP_ENV=local
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
